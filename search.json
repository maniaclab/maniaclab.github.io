---
layout: null
---
{%- assign items = "" | split: "" -%}
[
  {%- for p in site.pages -%}
    {%- if p.title and p.url != "/404.html" and p.url != "/search.json" and p.url != "/thanks/" -%}
    {%- unless p.url contains ".xml" or p.url contains ".txt" -%}
    { "title": {{ p.title | jsonify }}, "section": "Page", "text": {{ p.hero.description | default: p.categories.subtitle | default: p.timeline.subtitle | default: p.intro.text | default: "" | strip_html | jsonify }}, "url": {{ p.url | relative_url | jsonify }} },
    {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for d in site.projects -%}
    { "title": {{ d.title | jsonify }}, "section": "Project", "text": {{ d.lead | default: d.tagline | strip_html | jsonify }}, "url": {{ d.url | relative_url | jsonify }} },
  {%- endfor -%}
  {%- for c in site.collaborations -%}
    { "title": {{ c.title | jsonify }}, "section": "Collaboration", "text": {{ c.excerpt | strip_html | jsonify }}, "url": {{ c.url | relative_url | jsonify }} },
  {%- endfor -%}
  {%- for item in site.data.projects.current -%}
    {%- assign u = item.url | default: "" -%}
    {%- if u contains "/projects/" and u != "/projects/" -%}{%- else -%}
    { "title": {{ item.title | jsonify }}, "section": "Project", "text": {{ item.tagline | append: ". " | append: item.desc | jsonify }}, "url": {{ "/projects/#" | append: item.group | relative_url | jsonify }} },
    {%- endif -%}
  {%- endfor -%}
  {%- for item in site.data.projects.past -%}
    { "title": {{ item.title | jsonify }}, "section": "Past project", "text": {{ item.tagline | append: ". " | append: item.desc | jsonify }}, "url": {{ "/projects/#past" | relative_url | jsonify }} },
  {%- endfor -%}
  {%- for m in site.data.team.current -%}
    { "title": {{ m.name | jsonify }}, "section": "Team", "text": {{ m.title | append: ". " | append: m.desc | jsonify }}, "url": {{ "/team/" | relative_url | jsonify }} },
  {%- endfor -%}
  {%- for m in site.data.team.former -%}
    { "title": {{ m.name | jsonify }}, "section": "Former team member", "text": {{ m.title | append: ". " | append: m.desc | jsonify }}, "url": {{ "/team/#former" | relative_url | jsonify }} },
  {%- endfor -%}
  {%- for lane in site.data.timeline.lanes -%}{%- unless lane.team -%}{%- for t in lane.items -%}
    { "title": {{ t.title | jsonify }}, "section": "Award or project", "text": {{ t.full | default: t.title | append: ". " | append: t.sponsor | jsonify }}, "url": {{ "/about/" | relative_url | jsonify }} },
  {%- endfor -%}{%- endunless -%}{%- endfor -%}
  { "title": "MANIAC Lab", "section": "Home", "text": "AI and Facilities for Frontier Science", "url": {{ "/" | relative_url | jsonify }} }
]
